# ========================================================
# Wayfinder Server Deployment Configuration
# ========================================================

# Port the Wayfinder HTTP/WebSocket backend listens on
PORT=8080

# The public domain name configured in Cloudflare Zero Trust (e.g. wayfinder.disaac1.com)
PUBLIC_DOMAIN=wayfinder.disaac1.com

# Cloudflare Tunnel Token
# If specified, Wayfinder automatically downloads and runs cloudflared to expose the server.
CLOUDFLARE_TUNNEL_TOKEN=

# Hosting mode for Archipelago MultiServer connections:
# 'tunnel' (default) - Routes connections over Cloudflare reverse tunnel wss:// proxy with 15s heartbeats (zero port forwarding required).
# 'direct' - Connects clients directly to PUBLIC_HOST / IP on open ports (ideal for dedicated server / VPS deployments).
HOSTING_MODE=tunnel

# Optional persistent Archipelago.gg session identity.
# If omitted, the backend creates and persists one automatically in its runtime directory.
ARCHIPELAGO_GG_BASE_URL=https://archipelago.gg
ARCHIPELAGO_GG_SESSION_ID=

# Direct IP fallback / Archipelago Central MultiServer public host
PUBLIC_HOST=localhost

# Archipelago Central MultiServer port pool
AP_START_PORT=38000
AP_MAX_PORT=38010
