[node name="DescLabel" type="RichTextLabel" parent="LayoutVBox/BodyHBox/ContentPanel/Margin/ContentTabs/DashboardTab"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[b]Features of this pure UI template:[/b]

• [color=cornflowerblue]Low Processor Mode[/color] active: Godot sleeps when there are no events or animations, preventing battery drain and high GPU temps.
• [color=cornflowerblue]Compatibility Renderer[/color] enabled: Lightweight, instant cold startup, runs on any hardware.
• [color=cornflowerblue]ui_only.profile[/color]: Hides all 3D/2D game nodes from the editor's Create Node dialog so only UI Control nodes remain.
• [color=cornflowerblue]ui_only.build[/color]: SCons build profile configuration to compile tiny export templates without 3D modules."

