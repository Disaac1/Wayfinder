; Engine configuration file.
; UI-Only Godot Template

config_version=5

[application]

config/name="UI App Template"
config/description="Minimal Godot template configured purely for UI applications, with 2D/3D stripped."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=6900
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1152
window/size/viewport_height=720
window/size/min_width=800
window/size/min_height=500
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/subwindows/embed_subwindows=false

[gui]

theme/custom="res://assets/themes/app_theme.tres"

[physics]

common/physics_ticks_per_second=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.09, 0.1, 0.13, 1)
