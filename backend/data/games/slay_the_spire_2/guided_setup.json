{
  "game_title": "Slay the Spire II",
  "default_config": {
    "characters": [
      "ironclad",
      "silent",
      "defect",
      "regent",
      "necrobinder"
    ],
    "pick_num_characters": 2,
    "num_chars_goal": 0,
    "lock_characters": "locked_random",
    "unlocked_character": "ironclad",
    "campfire_sanity": false,
    "gold_sanity": false,
    "potion_sanity": false,
    "shop_sanity": false,
    "neow_sanity": false,
    "progressive_starter_card": false,
    "progressive_starter_relic": false,
    "death_link": false
  },
  "required_schema_keys": [
    "characters",
    "pick_num_characters",
    "num_chars_goal",
    "lock_characters",
    "death_link"
  ],
  "steps": [
    {
      "num": 1,
      "title": "1. Character Roster & Goals",
      "description": "Step 1: Choose characters to play (Ironclad, Silent, Defect, Regent, Necrobinder)",
      "controls": [
        {
          "type": "card_grid",
          "option_key": "pick_num_characters",
          "columns": 3,
          "items": [
            {
              "id": 1,
              "title": "\u26a1 Solo Climber (1 Hero)",
              "desc": "Focus entirely on one chosen hero's deck."
            },
            {
              "id": 2,
              "title": "\u2694\ufe0f Duo Climb (2 Heroes)",
              "desc": "Standard multiworld experience with 2 rotating classes."
            },
            {
              "id": 5,
              "title": "\ud83d\udc51 All Five Heroes",
              "desc": "Climb the Spire with all five classes."
            }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "slider",
          "option_key": "pick_num_characters",
          "label": "Number of Characters to Pick (1 - 5):",
          "min": 1,
          "max": 5,
          "step": 1,
          "suffix": " hero(es)"
        },
        {
          "type": "slider",
          "option_key": "num_chars_goal",
          "label": "Characters Required for Victory (0 = all picked):",
          "min": 0,
          "max": 5,
          "step": 1,
          "suffix": " hero(es)"
        },
        {
          "type": "dropdown",
          "option_key": "lock_characters",
          "label": "Character Unlock Logic:",
          "choices": [
            {
              "id": "unlocked",
              "title": "All Unlocked (Play immediately)"
            },
            {
              "id": "locked_random",
              "title": "Locked Random (Find unlocks in multiworld)"
            },
            {
              "id": "locked_fixed",
              "title": "Locked Fixed (Start with selected hero)"
            }
          ]
        },
        {
          "type": "dropdown",
          "option_key": "unlocked_character",
          "label": "Starting Unlocked Character (if Locked Fixed):",
          "choices": [
            {
              "id": "ironclad",
              "title": "Ironclad"
            },
            {
              "id": "silent",
              "title": "Silent"
            },
            {
              "id": "defect",
              "title": "Defect"
            },
            {
              "id": "regent",
              "title": "Regent"
            },
            {
              "id": "necrobinder",
              "title": "Necrobinder"
            }
          ]
        }
      ]
    },
    {
      "num": 2,
      "title": "2. Starter Items & Ancients",
      "description": "Step 2: Progressive starter cards, relics, and Neow blessings",
      "controls": [
        {
          "type": "checkbox",
          "option_key": "progressive_starter_card",
          "label": "Progressive Starter Card",
          "desc": "Start without your signature starter card and unlock it progressively through multiworld items."
        },
        {
          "type": "checkbox",
          "option_key": "progressive_starter_relic",
          "label": "Progressive Starter Relic",
          "desc": "Start without your character's starter relic and find it in the multiworld."
        },
        {
          "type": "checkbox",
          "option_key": "neow_sanity",
          "label": "Neow Sanity",
          "desc": "Turn Neow's blessing choices at the start of each run into Archipelago check locations."
        }
      ]
    },
    {
      "num": 3,
      "title": "3. Sanity & Check Pool",
      "description": "Step 3: Shuffle campsites, gold, potions, and shop slots into multiworld",
      "controls": [
        {
          "type": "checkbox",
          "option_key": "campfire_sanity",
          "label": "Campfire Sanity",
          "desc": "Shuffle Rest and Smith campsite capabilities per Act into the multiworld."
        },
        {
          "type": "checkbox",
          "option_key": "gold_sanity",
          "label": "Gold Sanity",
          "desc": "Adds gold reward check locations to the multiworld pool."
        },
        {
          "type": "checkbox",
          "option_key": "potion_sanity",
          "label": "Potion Sanity",
          "desc": "Adds potion reward drops to the multiworld check pool."
        },
        {
          "type": "checkbox",
          "option_key": "shop_sanity",
          "label": "Shop Sanity",
          "desc": "Shuffle card, relic, and potion shop slots into the item pool."
        }
      ]
    },
    {
      "num": 4,
      "title": "4. Death Link & Co-Op",
      "description": "Step 4: Configure multiplayer Death Link",
      "controls": [
        {
          "type": "checkbox",
          "option_key": "death_link",
          "label": "Enable Death Link",
          "desc": "When you perish on a floor, all linked players take damage or perish."
        }
      ]
    }
  ]
}