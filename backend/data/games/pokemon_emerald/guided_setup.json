  "steps": [
    {
      "num": 1,
      "title": "1. Goal & Pace",
      "description": "Step 1: Choose your Win Condition and Game Length",
      "controls": [
        {
          "type": "card_grid",
          "option_key": "goal",
          "columns": 2,
          "items": [
            {
              "id": "champion",
              "val": 0,
              "title": "🏆 Become Champion",
              "desc": "Defeat the Elite Four & Champion in the Hall of Fame. Standard full game."
            },
            {
              "id": "steven",
              "val": 1,
              "title": "🏔️ Defeat Steven",
              "desc": "Defeat Steven Stone in Meteor Falls after completing the main game."
            },
            {
              "id": "norman",
              "val": 2,
              "title": "🥊 Defeat Norman",
              "desc": "Short game goal! Beat Norman at Petalburg Gym to win early."
            },
            {
              "id": "legendary_hunt",
              "val": 3,
              "title": "🐉 Legendary Hunt",
              "desc": "Defeat or catch a specified number of legendary Pokémon across Hoenn."
            }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "slider",
          "option_key": "norman_count",
          "label": "Norman Gym Requirements (Badges required):",
          "min": 0,
          "max": 7,
          "step": 1,
          "suffix": " Badges"
        },
        {
          "type": "slider",
          "option_key": "elite_four_count",
          "label": "Elite Four Requirements (Badges required):",
          "min": 0,
          "max": 8,
          "step": 1,
          "suffix": " Badges"
        }
      ]
    },
    {
      "num": 2,
      "title": "2. World & Items",
      "description": "Step 2: Item Locations & World Access Presets",
      "controls": [
        {
          "type": "preset_grid",
          "columns": 3,
          "presets": [
            {
              "id": "standard",
              "name": "🔑 Standard",
              "desc": "Shuffles Key Items, Badges, HMs & Overworld items. Great default!",
              "values": {
                "badges": "completely_random",
                "hms": "completely_random",
                "key_items": true,
                "overworld_items": true,
                "hidden_items": false,
                "npc_gifts": false,
                "dexsanity": false,
                "trainersanity": false
              }
            },
            {
              "id": "full",
              "name": "🎁 Full Shuffle",
              "desc": "Adds Hidden Items, NPC Gifts, Berry Trees, Rods & Tickets to the pool.",
              "values": {
                "badges": "completely_random",
                "hms": "completely_random",
                "key_items": true,
                "overworld_items": true,
                "hidden_items": true,
                "npc_gifts": true,
                "berry_trees": true,
                "rods": true,
                "event_tickets": true,
                "dexsanity": false,
                "trainersanity": false
              }
            },
            {
              "id": "chaos",
              "name": "🌀 Max Chaos",
              "desc": "Enables Trainersanity & Dexsanity! Adds 300+ item locations.",
              "values": {
                "badges": "completely_random",
                "hms": "completely_random",
                "key_items": true,
                "overworld_items": true,
                "hidden_items": true,
                "npc_gifts": true,
                "dexsanity": true,
                "trainersanity": true
              }
            }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "toggle",
          "option_key": "key_items",
          "label": "Randomize Key Items (Scope, Letter, Basement Key, etc.)"
        },
        {
          "type": "toggle",
          "option_key": "overworld_items",
          "label": "Randomize Overworld Pokéballs"
        },
        {
          "type": "toggle",
          "option_key": "hidden_items",
          "label": "Randomize Hidden Items"
        },
        {
          "type": "toggle",
          "option_key": "npc_gifts",
          "label": "Randomize NPC Gifts"
        },
        {
          "type": "toggle",
          "option_key": "trainersanity",
          "label": "Trainersanity (Defeating trainers awards items)"
        },
        {
          "type": "toggle",
          "option_key": "dexsanity",
          "label": "Dexsanity (Catching Pokémon species awards items)"
        }
      ]
    },
    {
      "num": 3,
      "title": "3. Pokémon & Trainers",
      "description": "Step 3: Pokémon Species & Trainer Party Randomization",
      "controls": [
        {
          "type": "preset_grid",
          "columns": 3,
          "presets": [
            {
              "id": "vanilla",
              "name": "🌿 Vanilla",
              "desc": "Original GBA Pokémon encounters, starters & trainer teams.",
              "values": {
                "wild_pokemon": "vanilla",
                "starters": "vanilla",
                "trainer_parties": "vanilla",
                "types": "vanilla",
                "abilities": "vanilla"
              }
            },
            {
              "id": "balanced",
              "name": "⚖️ Balanced",
              "desc": "Randomized species matched by Base Stat Total & Type!",
              "values": {
                "wild_pokemon": "match_base_stats_and_type",
                "starters": "match_base_stats_and_type",
                "trainer_parties": "match_base_stats",
                "types": "vanilla",
                "abilities": "vanilla"
              }
            },
            {
              "id": "chaos",
              "name": "🤪 Total Chaos",
              "desc": "Wilds, Starters, Trainers, Types & Abilities completely random!",
              "values": {
                "wild_pokemon": "completely_random",
                "starters": "completely_random",
                "trainer_parties": "completely_random",
                "types": "completely_random",
                "abilities": "completely_random"
              }
            }
          ]
        },
        {
          "type": "separator"
        },
        {
          "type": "dropdown",
          "option_key": "wild_pokemon",
          "label": "Wild Pokémon Encounters:",
          "choices": [
            { "id": "vanilla", "title": "Vanilla" },
            { "id": "match_base_stats", "title": "Match Base Stats" },
            { "id": "match_type", "title": "Match Type" },
            { "id": "match_base_stats_and_type", "title": "Match Base Stats & Type" },
            { "id": "completely_random", "title": "Completely Random" }
          ]
        },
        {
          "type": "toggle",
          "option_key": "types",
          "label": "Randomize Pokémon Types"
        },
        {
          "type": "toggle",
          "option_key": "abilities",
          "label": "Randomize Pokémon Abilities"
        }
      ]
    },
    {
      "num": 4,
      "title": "4. Battle & Leveling",
      "description": "Step 4: Movesets, Battle Mechanics & EXP Multipliers",
      "controls": [
        {
          "type": "dropdown",
          "option_key": "level_up_moves",
          "label": "Level-Up Movesets:",
          "choices": [
            { "id": "vanilla", "title": "Vanilla Movesets" },
            { "id": "randomized", "title": "Randomized Level-Up Moves" },
            { "id": "start_with_four_moves", "title": "Randomized (Start with 4 Moves)" }
          ]
        },
        {
          "type": "slider",
          "option_key": "move_match_type_bias",
          "label": "Move Match Type Bias (Probability learned move matches Pokémon type):",
          "min": 0,
          "max": 100,
          "step": 5,
          "suffix": "%",
          "condition": {
            "option_key": "level_up_moves",
            "not_equals": "vanilla"
          }
        },
        {
          "type": "toggle",
          "option_key": "tm_tutor_moves",
          "label": "Randomize TM & Move Tutor Moves"
        },
        {
          "type": "separator"
        },
        {
          "type": "slider",
          "option_key": "exp_modifier",
          "label": "EXP Gain Multiplier:",
          "min": 50,
          "max": 500,
          "step": 25,
          "suffix": "%"
        },
        {
          "type": "toggle",
          "option_key": "reusable_tms_tutors",
          "label": "Reusable TMs & Infinite Move Tutors"
        },
        {
          "type": "toggle",
          "option_key": "guaranteed_catch",
          "label": "Guaranteed Catch (Every Pokéball succeeds)"
        }
      ]
    },
    {
      "num": 5,
      "title": "5. QoL & Extras",
      "description": "Step 5: Quality of Life & Multiplayer Extras",
      "controls": [
        {
          "type": "toggle",
          "option_key": "turbo_a",
          "label": "⚡ Turbo A (Hold A to auto-advance dialogue)"
        },
        {
          "type": "toggle",
          "option_key": "better_shops",
          "label": "🏪 Better Shops (Pokémarts sell all TMs & Stones)"
        },
        {
          "type": "toggle",
          "option_key": "music",
          "label": "🎵 Randomize Music Tracks"
        },
        {
          "type": "toggle",
          "option_key": "fanfares",
          "label": "🎺 Randomize Pickups & Fanfares"
        },
        {
          "type": "toggle",
          "option_key": "death_link",
          "label": "💀 DeathLink (Fainting triggers death for partners)"
        },
        {
          "type": "toggle",
          "option_key": "enable_wonder_trading",
          "label": "🤝 Wonder Trading (Trade Pokémon online in Pokénav/Center)"
        }
      ]
    }
  ]
}
