    "goal",
    "norman_count",
    "elite_four_count",
    "badges",
    "hms",
    "key_items",
    "overworld_items",
    "wild_pokemon",
    "starters",
    "trainer_parties",
    "exp_modifier",
    "reusable_tms_tutors",
    "turbo_a",
    "better_shops"
